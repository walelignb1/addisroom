DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# For real delivery, use provider. Console mode only works outside production.
AUTH_DELIVERY_MODE="provider"
RESEND_API_KEY=""
AUTH_EMAIL_FROM="AddisRoom <verify@your-verified-domain.com>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# Generate once: openssl rand -hex 32. Keep it stable and back it up securely.
IDENTITY_ENCRYPTION_KEY=""
# Enable only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY="false"

# Google OAuth web application. Callback: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
